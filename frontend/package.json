{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-preloads.cjs",
    "build": "vue-tsc -b && vite-ssg build",
